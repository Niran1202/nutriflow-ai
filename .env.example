# Copy to .env for local development. On the Oracle VM, deploy/oracle/setup.sh
# writes the server's own .env — you don't need to create one there.

# SQLite database for local development (demo data from `npm run setup`).
# The live server always uses server-data/nutriflow.db instead.
DATABASE_URL="file:./nutriflow.db"

# Local LLM via Ollama. If Ollama is not running or the model is missing,
# the agents fall back to deterministic template responses.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"

# Header holding the real visitor IP, used to rate-limit logins and invitation
# codes. Only change this if a different reverse proxy replaces Caddy.
# NUTRIFLOW_CLIENT_IP_HEADER="x-forwarded-for"

# Port for `npm run server:start` (Caddy proxies to it on the VM).
# NUTRIFLOW_PORT=3000
