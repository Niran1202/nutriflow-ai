{
  "name": "nutriflow-ai",
  "version": "0.1.0",
  "description": "A local-first, dietitian-supervised nutrition platform with AI-assisted coaching and monitoring.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma migrate deploy && prisma generate && tsx prisma/seed.ts",
    "agents:check": "tsx scripts/agents-check.ts",
    "server:setup": "tsx scripts/server.ts setup",
    "server:dietitian": "tsx scripts/server.ts dietitian",
    "server:list": "tsx scripts/server.ts list",
    "server:start": "tsx scripts/server.ts start"
  },
  "dependencies": {
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/ollama": "^1.3.0",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
